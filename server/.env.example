PORT=3000
FRONTEND_URL=http://localhost:5173
# Windows: bin/yt-dlp.exe ; Linux/macOS: bin/yt-dlp
YTDLP_PATH=
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_CONVERSIONS=2
NODE_ENV=production
TRUST_PROXY=true
# Optional: when set, /api/download requires X-Turnstile-Token.
TURNSTILE_SECRET_KEY=
LOG_LEVEL=info
